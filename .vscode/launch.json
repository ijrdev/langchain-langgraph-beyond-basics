
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "LangGraph Dev",
            "type": "debugpy",
            "request": "launch",
            "module": "langgraph_cli",
            "args": [
                "dev",
                // "--tunnel",
                "--no-reload",
                "--allow-blocking",
                // "--config",
                // "langgraph.json"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": true
        }
    ]
}
